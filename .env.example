# 首次配置时，在项目根目录复制为 .env 并填写。
# 环境变量优先于 .env；--api、--model 优先于相应环境变量。

# Bearer Token；只发送本项目明确配置的凭据。
JOHNNY_API_KEY=

# 服务根地址，例如 https://your-relay.example，也支持 https://your-relay.example/v1。
# 不要填写完整的 /v1/messages、/v1/responses 或 /v1/chat/completions。
JOHNNY_BASE_URL=

# 服务实际提供的模型标识，含空格时建议加引号。
JOHNNY_MODEL=

# 可选；已有配置不加此项时默认使用 anthropic-messages。
# 可选值：anthropic-messages、openai-responses、openai-chat-completions。
JOHNNY_API=anthropic-messages
